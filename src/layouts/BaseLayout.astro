---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import { SITE } from '../data/profile';
import { LANG_OPTIONS, UI_COPY, localizedPath, type Lang } from '../data/i18n';

interface Props {
  title: string;
  description?: string;
  note?: 'purple' | 'blue' | 'green' | 'yellow' | 'red' | 'brown';
  activeNav?: 'home' | 'work' | 'cv';
  lang?: Lang;
  currentPath?: string;
  includeSchema?: boolean;
}

const {
  title,
  description = UI_COPY.en.seo.homeDescription,
  note = 'purple',
  activeNav = 'home',
  lang = 'en',
  currentPath = '/',
  includeSchema = false,
} = Astro.props;

const t = UI_COPY[lang];
const homeUrl = localizedPath('/', lang);
const workUrl = localizedPath('/work/', lang);
const cvUrl = localizedPath('/cv/', lang);

const langUrls = {
  en: localizedPath(currentPath, 'en'),
  fr: localizedPath(currentPath, 'fr'),
  de: localizedPath(currentPath, 'de'),
};

const canonicalUrl = `${SITE.siteUrl}${localizedPath(currentPath, lang)}`;
const ogImageUrl = `${SITE.siteUrl}/images/keshav-portrait.jpg`;

const personSchema = includeSchema
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: SITE.name,
      jobTitle: SITE.title,
      url: SITE.siteUrl,
      image: ogImageUrl,
      email: SITE.email,
      telephone: SITE.phone,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Geneva',
        addressCountry: 'CH',
      },
      sameAs: [SITE.linkedin, SITE.github, SITE.medium, SITE.tableau],
      knowsAbout: [
        'Business Intelligence',
        'Power BI',
        'Microsoft Fabric',
        'SQL',
        'PostgreSQL',
        'Python',
        'Data Engineering',
        'ETL',
        'Generative AI',
        'Retrieval-Augmented Generation',
        'Model Context Protocol',
      ],
    })
  : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`${SITE.siteUrl}${langUrls.en}`} />
    <link rel="alternate" hreflang="fr" href={`${SITE.siteUrl}${langUrls.fr}`} />
    <link rel="alternate" hreflang="de" href={`${SITE.siteUrl}${langUrls.de}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE.siteUrl}${langUrls.en}`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CH' : lang === 'de' ? 'de_CH' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {personSchema && <script type="application/ld+json" set:html={personSchema} />}

    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
        else if (matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
    </script>
  </head>
  <body data-note={note}>
    <a class="skip" href="#main">{t.skip}</a>

    <nav class="topnav" aria-label="Primary navigation">
      <div class="wrap">
        <a class="brand" href={homeUrl}>{SITE.name}</a>
        <ul>
          <li>
            <a href={homeUrl} aria-current={activeNav === 'home' ? 'page' : undefined}>{t.nav.home}</a>
          </li>
          <li>
            <a href={`${homeUrl}#experience`}>{t.nav.experience}</a>
          </li>
          <li>
            <a href={`${homeUrl}#work`} aria-current={activeNav === 'work' ? 'page' : undefined}>{t.nav.projects}</a>
          </li>
          <li>
            <a href={`${homeUrl}#stack`}>{t.nav.stack}</a>
          </li>
          <li>
            <a href={`${homeUrl}#about`}>{t.nav.about}</a>
          </li>
          <li>
            <a href={`${homeUrl}#contact`}>{t.nav.contact}</a>
          </li>
          <li>
            <a href={cvUrl} aria-current={activeNav === 'cv' ? 'page' : undefined}>{t.nav.cv}</a>
          </li>
        </ul>
        <div class="nav-controls">
          <select
            class="lang-select"
            aria-label={t.nav.langLabel}
            data-lang-select
            data-en-url={langUrls.en}
            data-fr-url={langUrls.fr}
            data-de-url={langUrls.de}
          >
            {LANG_OPTIONS.map((opt) => (
              <option value={opt.code} selected={opt.code === lang}>
                {opt.short} · {opt.label}
              </option>
            ))}
          </select>
          <button
            class="toggle"
            type="button"
            data-toggle
            data-dark-label={t.nav.themeDark}
            data-light-label={t.nav.themeLight}
            aria-pressed="false"
          >
            {t.nav.themeDark}
          </button>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="sitefoot">
      <div class="wrap">
        <p>
          {t.footer.line1}{' '}
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      const btn = document.querySelector('[data-toggle]');
      if (btn) {
        const darkLabel = btn.getAttribute('data-dark-label') || 'Dark';
        const lightLabel = btn.getAttribute('data-light-label') || 'Light';
        const sync = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          btn.textContent = dark ? lightLabel : darkLabel;
          btn.setAttribute('aria-pressed', String(dark));
        };
        sync();
        btn.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
          sync();
        });
      }

      const langSelect = document.querySelector('[data-lang-select]');
      if (langSelect) {
        langSelect.addEventListener('change', (e) => {
          const code = e.target.value;
          try {
            localStorage.setItem('preferred-lang', code);
          } catch {}
          const targetUrl = langSelect.getAttribute(`data-${code}-url`);
          if (targetUrl) {
            window.location.href = targetUrl + (window.location.hash || '');
          }
        });
      }

      const topnav = document.querySelector('.topnav');
      if (topnav) {
        const bands = Array.from(document.querySelectorAll('header.field, main section, main.body, main.cv, main.section'));
        const getBandTone = (el) => {
          for (const tone of ['purple', 'blue', 'green', 'brown', 'red', 'yellow']) {
            if (el.classList.contains(tone)) return tone;
          }
          return 'paper';
        };
        const onScroll = () => {
          const scrolled = window.scrollY > 16;
          topnav.classList.toggle('is-scrolled', scrolled);
          const probeY = 28;
          let activeTone = document.body.getAttribute('data-note') || 'purple';
          for (const el of bands) {
            const rect = el.getBoundingClientRect();
            if (rect.top <= probeY && rect.bottom > probeY) {
              activeTone = getBandTone(el);
              break;
            }
          }
          topnav.setAttribute('data-over', activeTone);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
