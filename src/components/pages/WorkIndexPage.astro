---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Waves from '../Waves.astro';
import { UI_COPY, localizedPath, type Lang } from '../../data/i18n';
import { WORK_TRANSLATIONS } from '../../data/localizedContent';
import { getCompanyLogo, getTechLogo } from '../../data/logos';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI_COPY[lang];
const allWork = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const categories = ['All', 'BI & Governance', 'AI & Automation', 'Data Engineering', 'SQL & Analytics'];
---
<BaseLayout
  title={t.seo.workTitle}
  description={t.seo.workDescription}
  note="green"
  activeNav="work"
  lang={lang}
  currentPath="/work/"
>
  <header class="field green">
    <Waves seed={3} count={22} />
    <div class="wrap pagehead">
      <a class="back-link" href={localizedPath('/', lang)}>{t.workPage.backHome}</a>
      <h1 class="display">{t.workPage.heading}</h1>
      <p class="tagline">{t.workPage.tagline}</p>
      <dl class="stats">
        <div>
          <dt>{allWork.length}</dt>
          <dd>{t.workPage.statsCases}</dd>
        </div>
        <div>
          <dt>PL-300</dt>
          <dd>{t.workPage.statsCert}</dd>
        </div>
        <div>
          <dt>4</dt>
          <dd>{t.workPage.statsLive}</dd>
        </div>
      </dl>
    </div>
  </header>

  <main id="main" class="section quiet">
    <div class="wrap">
      <div class="filters" role="group" aria-label={t.workPage.filterLabel}>
        {categories.map((cat, idx) => (
          <button
            type="button"
            class="filter-btn"
            data-filter={cat}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {t.workPage.categories[cat] ?? cat}
          </button>
        ))}
      </div>

      <ul class="rows paper-rows" id="work-list">
        {allWork.map((entry) => {
          const tr = lang === 'en' ? null : WORK_TRANSLATIONS[lang][entry.slug];
          const title = tr?.title ?? entry.data.title;
          const org = tr?.organization ?? entry.data.organization;
          const tagline = tr?.tagline ?? entry.data.tagline;
          const catLabel = tr?.categoryLabel ?? entry.data.category;
          const orgLogo = getCompanyLogo(entry.data.organization);
          const externalLinks = entry.data.links.filter((l) => l.url.startsWith('http'));

          return (
            <li data-category={entry.data.category}>
              <div>
                <a href={localizedPath(`/work/${entry.slug}/`, lang)}>
                  <h3>{title}</h3>
                  <span class="who">
                    {orgLogo && (
                      <span class="mini-org-logo inline-logo">
                        <img src={orgLogo.src} alt={orgLogo.alt} loading="lazy" />
                      </span>
                    )}
                    {catLabel} · {org} · {entry.data.year}
                  </span>
                </a>
                {entry.data.image && (
                  <a class="list-thumb" href={localizedPath(`/work/${entry.slug}/`, lang)}>
                    <img src={entry.data.image} alt={entry.data.imageCaption || title} loading="lazy" />
                  </a>
                )}
              </div>
              <div>
                <p>
                  <span class="desc">{tagline}</span>
                </p>
                <div class="tech-chips">
                  {entry.data.builtWith.map((tool) => {
                    const icon = getTechLogo(tool);
                    return (
                      <span class="tech-chip">
                        {icon && <img class="tech-chip-icon" src={icon} alt="" loading="lazy" />}
                        {tool}
                      </span>
                    );
                  })}
                </div>
                <div class="project-links project-links-dark">
                  <a class="case-link" href={localizedPath(`/work/${entry.slug}/`, lang)}>
                    {t.workPage.viewCaseStudy}
                  </a>
                  {externalLinks.map((lnk) => (
                    <a href={lnk.url} target="_blank" rel="noopener noreferrer">
                      {lnk.label}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </main>

  <script is:inline>
    const buttons = document.querySelectorAll('[data-filter]');
    const items = document.querySelectorAll('#work-list li');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const chosen = btn.getAttribute('data-filter');
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((li) => {
          const cat = li.getAttribute('data-category');
          li.style.display = chosen === 'All' || cat === chosen ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
