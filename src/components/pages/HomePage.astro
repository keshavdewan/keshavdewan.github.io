---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Waves from '../Waves.astro';
import Rosette from '../Rosette.astro';
import { SITE } from '../../data/profile';
import { UI_COPY, localizedPath, type Lang } from '../../data/i18n';
import {
  EXPERIENCE_I18N,
  STACK_I18N,
  BRAND_PILLARS_I18N,
  TARGET_ROLES_I18N,
  WORK_TRANSLATIONS,
} from '../../data/localizedContent';
import { TECH_STACK_LOGOS, getCompanyLogo, getTechLogo } from '../../data/logos';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI_COPY[lang];
const allWork = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const selectedWork = allWork.filter((entry) => entry.data.featured);
const latestRoles = EXPERIENCE_I18N[lang].slice(0, 3);
const stackColumns = STACK_I18N[lang];
const pillars = BRAND_PILLARS_I18N[lang];
const targetRoles = TARGET_ROLES_I18N[lang];

const getProjectDisplay = (entry: (typeof allWork)[number]) => {
  if (lang === 'en') {
    return {
      title: entry.data.title,
      organization: entry.data.organization,
      tagline: entry.data.tagline,
    };
  }
  const tr = WORK_TRANSLATIONS[lang][entry.slug];
  return {
    title: tr?.title ?? entry.data.title,
    organization: tr?.organization ?? entry.data.organization,
    tagline: tr?.tagline ?? entry.data.tagline,
  };
};
---
<BaseLayout
  title={t.seo.homeTitle}
  description={t.seo.homeDescription}
  note="purple"
  activeNav="home"
  lang={lang}
  currentPath="/"
  includeSchema={true}
>
  <header class="field purple hero">
    <Waves seed={1} count={26} />
    <div class="wrap">
      <div>
        <p class="hero-kicker">{SITE.name}</p>
        <h1 class="display hero-title">{t.hero.heading}</h1>
        <p class="role">{t.hero.specialization}</p>
        <p class="focus">{t.hero.locationBadge}</p>
        <div class="hero-intros">
          <p>{t.hero.intro1}</p>
          <p>{t.hero.intro2}</p>
          <p>{t.hero.intro3}</p>
        </div>
        <p class="actions">
          <a class="btn solid" href={localizedPath('/work/', lang)}>{t.hero.ctaProjects}</a>
          <a class="btn" href={SITE.cvPdf} download>{t.hero.ctaCv}</a>
          <a class="btn" href="#contact">{t.hero.ctaContact}</a>
        </p>
      </div>
      <div class="art">
        <Rosette />
        <div class="portrait">
          <img
            src="/images/keshav-portrait.jpg"
            alt={t.hero.portraitAlt}
            width="284"
            height="284"
          />
        </div>
      </div>
    </div>
  </header>

  <main id="main">
    <section id="experience" class="field blue section">
      <Waves seed={2} count={20} />
      <div class="wrap">
        <h2 class="display">{t.sections.experience}</h2>

        <div class="exp-stack">
          {latestRoles.map((role) => {
            const logo = getCompanyLogo(role.company);
            const orgLabel = role.organizationNote ? `${role.company} (${role.organizationNote})` : role.company;
            return (
              <article class="panel role-card role-card-spacious">
                <div class="role-head">
                  {logo && (
                    <div class="company-logo">
                      <img src={logo.src} alt={logo.alt} loading="lazy" />
                    </div>
                  )}
                  <div class="role-meta">
                    <div class="role-title-row">
                      <h3>{role.title}</h3>
                      <span class="role-dates">{role.period}</span>
                    </div>
                    <p class="at">{orgLabel} · {role.location}</p>
                  </div>
                </div>
                <p class="role-summary">{role.summary}</p>
                <ul class="role-bullets-grid">
                  {role.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                {role.stack && <p class="products">{role.stack}</p>}
              </article>
            );
          })}
        </div>

        <p class="more">
          <a href={`${localizedPath('/cv/', lang)}#experience`}>{t.sections.careerTimelineLink}</a>
        </p>
      </div>
    </section>

    <section id="work" class="field green section">
      <Waves seed={3} count={18} />
      <div class="wrap">
        <h2 class="display single-line-heading">{t.sections.projects}</h2>
        <div class="project-cards">
          {selectedWork.map((entry) => {
            const disp = getProjectDisplay(entry);
            const orgLogo = getCompanyLogo(entry.data.organization);
            const externalLinks = entry.data.links.filter((l) => l.url.startsWith('http'));
            return (
              <article class="project-card">
                {entry.data.image && (
                  <a class="project-thumb" href={localizedPath(`/work/${entry.slug}/`, lang)}>
                    <img src={entry.data.image} alt={entry.data.imageCaption || disp.title} loading="lazy" />
                  </a>
                )}
                <div class="project-card-body">
                  <div class="project-meta">
                    {orgLogo && (
                      <span class="mini-org-logo">
                        <img src={orgLogo.src} alt={orgLogo.alt} loading="lazy" />
                      </span>
                    )}
                    <span>{disp.organization}</span>
                  </div>
                  <h3>
                    <a href={localizedPath(`/work/${entry.slug}/`, lang)}>{disp.title}</a>
                  </h3>
                  <p class="project-desc">{disp.tagline}</p>
                  <div class="tech-chips">
                    {entry.data.builtWith.slice(0, 5).map((tool) => {
                      const icon = getTechLogo(tool);
                      return (
                        <span class="tech-chip">
                          {icon && <img class="tech-chip-icon" src={icon} alt="" loading="lazy" />}
                          {tool}
                        </span>
                      );
                    })}
                  </div>
                  <div class="project-links">
                    <a class="case-link" href={localizedPath(`/work/${entry.slug}/`, lang)}>
                      {t.sections.viewCaseStudy}
                    </a>
                    {externalLinks.map((lnk) => (
                      <a href={lnk.url} target="_blank" rel="noopener noreferrer">
                        {lnk.label}
                      </a>
                    ))}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        <p class="more">
          <a href={localizedPath('/work/', lang)}>{t.sections.otherProjectsLink}</a>
        </p>
      </div>
    </section>

    <section id="stack" class="field brown section">
      <Waves seed={4} count={16} />
      <div class="wrap">
        <h2 class="display">{t.sections.stack}</h2>
        <p class="lab-intro">{t.sections.stackIntro}</p>

        <p class="tech-strip-label">{t.sections.stackLogosLabel}</p>
        <ul class="tech-strip">
          {TECH_STACK_LOGOS.map((item) => (
            <li class="tech-pill">
              <img src={item.src} alt={`${item.name} logo`} loading="lazy" />
              <span>{item.name}</span>
            </li>
          ))}
        </ul>

        <ul class="machines">
          {stackColumns.map((col) => (
            <li>
              <strong>{col.name}</strong>
              <span class="hw">{col.tools}</span>
              <p>{col.detail}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="about" class="section quiet">
      <div class="wrap">
        <h2 class="display">{t.sections.aboutMe}</h2>
        <div class="about-grid">
          <div class="about-copy">
            {t.sections.aboutParagraphs.map((p) => (
              <p>{p}</p>
            ))}
            <p class="languages">
              <strong>{t.sections.languagesLabel}:</strong> {t.sections.languagesValue}
            </p>
            <div class="volunteering-block">
              <p class="volunteering-heading"><strong>{t.sections.volunteeringLabel}:</strong></p>
              <ul class="volunteering-list">
                {t.sections.volunteeringItems.map((vol) => (
                  <li>
                    <strong>{vol.org}</strong> — {vol.detail}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="about-side">
            <figure class="about-portrait">
              <img
                src="/images/keshav-portrait-about.jpg"
                alt={t.sections.aboutPortraitAlt}
                width="420"
                height="512"
                loading="lazy"
              />
            </figure>
            <ul class="pillars-list">
              {pillars.map((pillar) => (
                <li>
                  <strong>{pillar.title}</strong>
                  <span>{pillar.description}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="field red section">
      <Waves seed={6} count={15} />
      <div class="wrap">
        <h2 class="display">{t.sections.connectHeading}</h2>
        <p class="contact-lede">{t.sections.connectP1}</p>
        <p class="contact-sublede">{t.sections.connectP2}</p>

        <div class="roles-block">
          <h3>{t.sections.targetRolesLabel}</h3>
          <ul class="roles-chips">
            {targetRoles.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="contact-grid">
          <div>
            <h3>{t.sections.email}</h3>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </div>
          <div>
            <h3>{t.sections.phone}</h3>
            <a href={SITE.phoneHref}>{SITE.phone}</a>
          </div>
          <div>
            <h3>{t.sections.profiles}</h3>
            <div class="contact-links">
              <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
              <a href={SITE.medium} target="_blank" rel="noopener noreferrer">Medium</a>
              <a href={SITE.tableau} target="_blank" rel="noopener noreferrer">Tableau</a>
            </div>
          </div>
          <div>
            <h3>{t.sections.cv}</h3>
            <div class="contact-links">
              <a href={localizedPath('/cv/', lang)}>{t.sections.readOnline}</a>
              <a href={SITE.cvPdf} download>{t.sections.downloadPdf}</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
