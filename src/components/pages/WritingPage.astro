---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Waves from '../Waves.astro';
import { SITE } from '../../data/profile';
import { UI_COPY, localizedPath, type Lang } from '../../data/i18n';
import { ARTICLES_I18N } from '../../data/localizedContent';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI_COPY[lang];
const articles = ARTICLES_I18N[lang];
---
<BaseLayout
  title={t.writingPage.title}
  description={t.writingPage.tagline}
  note="yellow"
  activeNav="writing"
  lang={lang}
  currentPath="/writing/"
>
  <header class="field yellow">
    <Waves seed={5} count={20} />
    <div class="wrap pagehead">
      <a class="back-link" href={localizedPath('/', lang)}>{t.writingPage.backHome}</a>
      <h1 class="display">{t.writingPage.heading}</h1>
      <p class="tagline">{t.writingPage.tagline}</p>
      <p class="actions">
        <a class="btn solid" href={SITE.medium} target="_blank" rel="noopener noreferrer">
          {t.writingPage.followMedium}
        </a>
      </p>
    </div>
  </header>

  <main id="main" class="section quiet">
    <div class="wrap">
      <ul class="rows paper-rows">
        {articles.map((article) => (
          <li>
            <a href={article.url} target="_blank" rel="noopener noreferrer">
              <h3>{article.title}</h3>
              <span class="who">{article.category} · {article.venue} · {article.date}</span>
            </a>
            <p>
              <span class="desc">{article.summary}</span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>

